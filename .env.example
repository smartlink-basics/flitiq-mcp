# MCP server requires these to run.
# Copy to .env.local for local dev; never commit real values.

# Supabase service role — used to validate API keys against mcp_api_keys
# and to read user_profiles.role. Never expose this to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# VPS proxy that fronts FMCSA data (SAFER, L&I, SMS via Socrata).
# Same VPS the web + iOS apps already use.
VPS_BASE_URL=https://mcp.flitiq.com
VPS_AUTH_TOKEN=...

# Optional: rate-limit tuning. Defaults: 60 calls/min per API key.
# MCP_RATE_LIMIT_PER_MIN=60
