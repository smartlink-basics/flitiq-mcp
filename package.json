{
  "name": "@flitiq/mcp-server",
  "version": "0.1.0",
  "description": "FlitIQ MCP server — FMCSA carrier intelligence tools for Claude. Pro/Team subscribers only.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "fmcsa",
    "trucking",
    "freight",
    "carrier-vetting",
    "dot-lookup"
  ],
  "homepage": "https://flitiq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartlink-basics/flitiq-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/smartlink-basics/flitiq-mcp/issues",
    "email": "support@flitiq.com"
  },
  "author": "SmartLink Basics, LLC <support@flitiq.com> (https://flitiq.com)",
  "license": "UNLICENSED",
  "icon": "assets/icon.png",
  "type": "module",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "flitiq-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@supabase/supabase-js": "^2.45.0"
